---
// Assets
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Logo from "@/components/assets/Logo.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const sections = [
  {
    title: "Todas as paginas",
    links: [
      { name: "Pagina principal", href: "/" },
      { name: "Termos", href: "/terms" },
    ],
  },
  {
    title: "Recursos",
    links: [
      {
        name: "GitHub repositorio",
        href: "https://github.com/michael-andreuzza/astrosaas",
      },
    ],
  },
  {
    title: "Socials",
    links: [
      {
        name: "@gracianoX",
        href: "https://x.com/lexingtonthemes",
      },
      {
        name: "@graciano.netoo",
        href: "https://instagram.com/graciano.netoo",
      },
    ],
  },
];
const currentYear = new Date().getFullYear();
---

<footer>
  <Wrapper variant="standard" class="py-12">
    <div class="grid grid-cols-2 lg:grid-cols-4 items-start gap-x-8 gap-y-24">
      <a href="/">
        <Logo  class="text-[25px] text-black font-bold"/>
      </a>
      <div
        class="grid grid-cols-2 md:grid-cols-4 gap-y-8 gap-x-4 lg:col-span-3"
      >
        {
          sections.map(({ title, links }) => (
            <div>
              <Text
                tag="h3"
                variant="textSM"
                class=" text-base-900 font-medium uppercase"
              >
                {title}
              </Text>
              <ul role="list" class="mt-4 space-y-1">
                {links.map(({ name, href }) => (
                  <li>
                    <a
                      href={href}
                      class="text-sm font-medium text-base-500 hover:text-accent-600"
                    >
                      {name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </Wrapper>
</footer>
