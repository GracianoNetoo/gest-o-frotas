---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Edit from "@/components/fundations/icons/Edit.astro";
import Complete from "@/components/fundations/icons/Complete.astro";
import Eye from "@/components/fundations/icons/Eye.astro";
import Color from "@/components/fundations/icons/Color.astro";

const features = [
  "Paneil de administrador",
  "Estados dos veiculos",
  "Agendamento de manutenções",
  "Verificação de rotas",
  "Graficos confiaveis",
  "Historico de actividades",
  "Reporting Dashboards",
  "Acesso remoto",
  "Agerenciar numero de veiculos",
  "Verificação dos litros de gasolina",
  "Gerenciar variedades de veiculos",
];

const featureItems = [
  {
    icon: Edit,
    title: "Gerenciamento de contatos",
    description:
      "Organize e gerencie facilmente todos os contatos de seus motoristas em um só lugar.",
  },
  {
    icon: Complete,
    title: "Rastreamento de rotas",
    description:
      "Acompanhe o estado do veiculo desde a primeira viagem até a ultima manutenção com detalhados.",
  },
  {
    icon: Eye,
    title: "Previsão e cuidados",
    description: "Preveja perdas desnecessarias e planeje estratégias de acordo.",
  },
  {
    icon: Color,
    title: "Fluxos de trabalho automatizados",
    description: "Otimize processos com fluxos de trabalho automatizados e personalizáveis.",
  },
];
---

<section id="features">
  <Wrapper variant="standard" class="py-20">
    <div class="text-center max-w-2xl mx-auto lg:text-balance">
      <Text
        tag="span"
        variant="textSM"
        class="leading-normal font-bold uppercase text-accent-700"
      >
        Beneficios
      </Text>
      <Text
        tag="h2"
        variant="displayMD"
        class="tracking-tight mt-4 font-semibold text-base-900"
      >
        Capacitando empresas com soluções inteligentes.
      </Text>
      <Text tag="p" variant="textBase" class="mt-4 text-base-500 font-medium">
      A maneira mais eficiente de gerenciar seus gastos e aumentar o
        desempenho.
      </Text>
    </div>
    <div
      class="relative py-12 mx-auto overflow-hidden overflow-x-hidden 2xl:max-w-7xl"
    >
      <div class="grid justify-between w-full">
        <div
          class="absolute inset-0 left-0 z-10 from-white via-transparent w-44 bg-linear-to-r"
        >
        </div>
        <div
          class="absolute inset-0 left-0 z-10 ml-auto from-white via-transparent w-44 bg-linear-to-l"
        >
        </div>
      </div>
      <div class="relative flex items-center gap-2 whitespace-nowrap t">
        {
          features.map((feature) => (
            <span class="inline-flex items-center font-medium relative text-base-700 bg-base-50 px-4 py-1.5 text-sm rounded-lg">
              {feature}
            </span>
          ))
        }
      </div>
    </div>
    <dl
      class="grid grid-cols-2 text-center gap-x-6 gap-y-12 lg:grid-cols-4 lg:gap-y-16"
    >
      {
        featureItems.map((item) => (
          <div>
            <div class="flex flex-col gap-3 ">
              <item.icon class="size-5 mx-auto text-accent-700" />
              <dt>
                <Text
                  tag="h3"
                  variant="textLG"
                  class="text-base-900 font-medium"
                >
                  {item.title}
                </Text>
              </dt>
            </div>
            <dd>
              <Text tag="p" variant="textBase" class="mt-2 text-base-500">
                {item.description}
              </Text>
            </dd>
          </div>
        ))
      }
    </dl>
  </Wrapper>
</section>
