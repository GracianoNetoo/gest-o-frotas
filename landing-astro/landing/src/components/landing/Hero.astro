---
// Assets
import { Image } from "astro:assets";
import DashboardLight from "@/images/FireShot Capture 002 - my-vue-dashboard - [localhost].jpg";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Logo from "../assets/Logo.astro";
---

<section class="overflow-hidden">
  <Wrapper class="pt-32">
    <div class="max-w-2xl text-center mx-auto lg:text-balance">
      <Text
        tag="span"
        variant="textSM"
        class="leading-normal font-bold uppercase text-accent-700"
      >
        Bem-vindo a
      </Text>
      <Logo  class="text-[25px] text-black font-bold ps-1"/>
      <Text
        tag="h1"
        variant="displayMD"
        class="tracking-tight mt-4 font-semibold text-base-900"
      >
      Comece agora controlando tudo que acontece <br> os seus veiculos em um clique
      </Text>
      <Text tag="p" variant="textBase" class="mt-4 text-base-500 font-medium text-balance">
        Seções de recursos, tabela de preços e formulários completos.
      </Text>
      <div class="flex flex-wrap items-center gap-2 justify-center mt-12">
        <Button
        variant="muted"
          size="sm"
          href="#" class="bnt text-white hover:text-black">Ver Mais</Button
        >
        <Button
          variant="accent"
          size="sm"
          isLink
          href="#"
        >
          Beneficios</Button
        >
      </div>
    </div>

    <div class="relative w-full mx-auto max-w-7xl items-center py-12 pb-12">
      <Image
        alt="Dashboard"
        width={900}
        height={700}
        alt="#_"
        src={DashboardLight}
        class="relative w-full ring-4 ring-base-50 border border-base-200 lg:rounded-2xl object-cover rounded"
      />
    </div>
  </Wrapper>
</section>
