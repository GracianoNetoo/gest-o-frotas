---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Plus from "@/components/fundations/icons/Plus.astro";
  const faqs = [
  {
    question: "O que é um sistema de gestão de frotas?",
    answer:
      "É uma plataforma centralizada que permite monitorar veículos, controlar custos operacionais (como combustível e manutenção), gerenciar motoristas e garantir a conformidade logística da sua empresa.",
  },
  {
    question: "Como começo a cadastrar minha frota no sistema?",
    answer:
      "Basta acessar o dashboard, utilizar a ferramenta de importação em massa para seus veículos e motoristas, e configurar os alertas de manutenção preventiva para começar a operar.",
  },
  {
    question: "Quais são as principais funcionalidades oferecidas?",
    answer:
      "Oferecemos controle de abastecimento, telemetria em tempo real, gestão de pneus, cronograma de manutenção preventiva, controle de multas e relatórios de desempenho por veículo.",
  },
  {
    question: "O sistema emite alertas de manutenção?",
    answer:
      "Sim, você pode configurar alertas baseados em quilometragem (KM), horas de uso ou data, garantindo que trocas de óleo, revisões e licenciamentos nunca passem do prazo.",
  },
  {
    question: "É possível integrar com cartões de combustível?",
    answer:
      "Com certeza! Suportamos integração via API com as principais operadoras de cartões de combustível e sistemas de pedágio para automação de lançamentos financeiros.",
  },
  {
    question: "Como o sistema ajuda na redução de custos?",
    answer:
      "Através do monitoramento de consumo excessivo, identificação de rotas ineficientes e redução de quebras inesperadas com a manutenção preventiva, nossas frotas parceiras economizam em média 15% ao ano.",
  },
  {
    question: "Os motoristas têm acesso ao sistema?",
    answer:
      "Sim, possuímos um módulo específico para motoristas onde eles podem realizar checklists de saída, registrar abastecimentos e reportar incidentes diretamente pelo celular.",
  },
  {
    question: "Os dados da minha empresa estão seguros?",
    answer:
      "Sim, utilizamos criptografia de ponta a ponta e servidores seguros (AWS), além de estarmos em total conformidade com a LGPD para garantir a privacidade dos dados da sua operação.",
  },
  {
    question: "Consigo gerar relatórios para auditoria?",
    answer:
      "Sim, o sistema gera relatórios detalhados de custo por KM rodado, histórico de manutenção e comportamento do motorista, exportáveis em PDF ou Excel a qualquer momento.",
  },
  {
    question: "Existe suporte técnico especializado?",
    answer:
      "Oferecemos suporte 24/7 via chat e telefone com especialistas que entendem de logística, além de treinamentos ao vivo para a sua equipe de tráfego.",
  },
];
---

<section id="faq">
  <Wrapper variant="standard" class="py-20">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-12">
      <div>
        <Text
          tag="span"
          variant="textSM"
          class="leading-normal font-bold uppercase text-accent-700"
        >
          faq
        </Text>
        <Text
          tag="h2"
          variant="displayMD"
          class="tracking-tight mt-4 font-semibold text-base-900"
        >
          Perguntas frequentes
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="mt-4 text-base-500 font-medium text-balance"
        >
          Respostas às perguntas mais frequentes sobre nossa sistema
        </Text>
      </div>
      <div class="lg:col-span-2">
        {
          faqs.map((faq) => (
            <details class="group pb-4">
              <summary class="cursor-pointer flex items-center justify-between w-full  text-left font-medium select-none text-base-600 hover:text-accent-800 ">
                <Text tag="h3" variant="textLG">
                  {faq.question}
                </Text>
                <Plus class="size-5 duration-300 ease-out text-base-500 group-open:rotate-45" />
              </summary>
              <Text
                tag="p"
                variant="textBase"
                class="pb-4 pt-2  text-base-500 text-balance"
              >
                {faq.answer}
              </Text>
            </details>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
