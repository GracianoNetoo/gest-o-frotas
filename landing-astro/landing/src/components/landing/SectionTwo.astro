---
// Assets
import { Image } from "astro:assets";
import DashboardLight from "@/images/FireShot Capture 001 - my-vue-dashboard - [localhost].png";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Check from "@/components/fundations/icons/Check.astro";

const sections = [
  {
    title: "Interface de usuário intuitiva",
    description:
      "Nosso design elegante e intuitivo garante uma experiência de usuário tranquila, tornando o gerenciamento fácil e agradável.",
    features: ["Dashboard amigavel", "Funcionalidade de adicionar e remover"],
  },
  {
    title: "Análise poderosa",
    description:
      "Obtenha estatisticas profundos com ferramentas analíticas avançadas que ajudam você a entender o funciomento do seu negocio.",
    features: ["Relatórios em Tempo Real", "Controle de manutenções"],
  },
  {
    title: "Integrações perfeitas",
    description:
      "Conecte-se facilmente com ferramentas na plataforma faceis de usar e obter um fluxo de trabalho unificado e eficiente.",
    features: ["Conectividade API", "Suporte tecnico."],
  },
];
---

<section>
  <Wrapper variant="standard" class="py-20">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-center">
      <div class="lg:order-last">
        <Text
          tag="span"
          variant="textSM"
          class="leading-normal font-bold uppercase text-accent-700"
        >
          Mais Beneficios
        </Text>
        <Text
          tag="h2"
          variant="displayMD"
          class="tracking-tight mt-4 font-semibold text-base-900"
        >
        Tenha todas informações do seu negocio em um clique.
        </Text>
        <Text tag="p" variant="textBase" class="mt-4 text-base-500 font-medium">
        A solução definitiva para gerenciar interações com motoristas e
          impulsionando o crescimento dos negócios.
        </Text>
        <div class="flex flex-wrap items-center gap-2 mx-auto mt-5">
          <Button
            variant="accent"
            size="sm"
            isLink
            href="/">Começar agora</Button
          >

        </div>
      </div>
      <div class="lg:col-span-2">
        <Image
          alt="Dashboard"
          width={900}
          height={700}
          src={DashboardLight}
          class="object-cover h-full ring-4 ring-base-50 border border-base-200 rounded-2xl"
        />
      </div>
    </div>
    <div
      class="gap-x-2 gap-y-14 mt-12 lg:gap-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        sections.map((section) => (
          <div>
            <div>
              <Text tag="h3" variant="textLG" class="text-base-900 font-medium">
                {section.title}
              </Text>
              <Text tag="p" variant="textBase" class="mt-2 text-base-500">
                {section.description}
              </Text>
            </div>
            <ul
              role="list"
              class="space-y-1 mt-6 text-base font-medium text-base-900"
            >
              {section.features.map((feature) => (
                <li>
                  <div class="flex items-center gap-4">
                    <Check class="size-5 text-accent-600" />
                    <Text tag="p" variant="textSM" class="text-base-500">
                      {feature}
                    </Text>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
